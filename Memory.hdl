// Capstone - Hack data memory
// 0 - 16383      RAM16K
// 16384 - 24575  Screen
// 24576          Keyboard

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // The top two address bits choose the device:
    // 00 and 01 -> RAM, 10 -> Screen, 11 -> Keyboard
    DMux4Way(in=load, sel=address[13..14], a=ramA, b=ramB, c=screenLoad, d=unused);
    Or(a=ramA, b=ramB, out=ramLoad);

    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);
    Screen(in=in, load=screenLoad, address=address[0..12], out=screenOut);
    Keyboard(out=keyOut);

    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=keyOut, sel=address[13..14], out=out);
}
